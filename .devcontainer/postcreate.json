#!/usr/bin/env bash
set -eux

if ! command -v composer >/dev/null 2>&1; then
  curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer
fi

export PATH="$HOME/.config/composer/vendor/bin:$PATH"

if ! composer --version >/dev/null 2>&1; then
  echo "Composer não está disponível após a instalação." >&2
  exit 1
fi

composer global require laravel/installer

if [ ! -f "artisan" ]; then
  composer create-project laravel/laravel .
fi

if [ ! -f ".env" ]; then
  cp .env.example .env
fi

php artisan key:generate --force || true

sed -i 's|DB_HOST=127.0.0.1|DB_HOST=127.0.0.1|g' .env
sed -i 's|DB_PORT=3306|DB_PORT=3306|g' .env
sed -i 's|DB_DATABASE=laravel|DB_DATABASE=laravel|g' .env
sed -i 's|DB_USERNAME=root|DB_USERNAME=root|g' .env
sed -i 's|DB_PASSWORD=|DB_PASSWORD=root|g' .env

if command -v mysql >/dev/null 2>&1; then
  mysql --host=127.0.0.1 --user=root --password=root -e "CREATE DATABASE IF NOT EXISTS laravel;" || true
fi

php artisan migrate --force || true

echo "Ambiente configurado com sucesso!"
